body {
    font-family: Arial;
    margin: 0;
    background: #f3f3f3;
}

header {
    background: #232f3e;
    color: white;
    padding: 15px;
    text-align: center;
}

header input {
    padding: 8px;
    width: 200px;
}

header button {
    padding: 8px;
}

.products {
    display: flex;
    justify-content: space-around;
    margin: 20px;
}

.card {
    background: white;
    padding: 15px;
    border-radius: 10px;
    text-align: center;
    width: 200px;
}

.card img {
    width: 100%;
}

button {
    background: orange;
    border: none;
    padding: 10px;
    cursor: pointer;
}

.cart {
    background: white;
    margin: 20px;
    padding: 15px;
}